; BSPRJ <-> INA3221-C3 PRELIMINARY UART NETLIST
; Status: BUILDS_119_AND_C3_185_TEL_ACK_BUILD_PASS_MANUAL_UPLOAD_PENDING
; Safety: NEVER MOVE UART WIRES WHILE EITHER CONTROLLER IS POWERED.
; Purpose: reserve and verify a low-power 3.3 V UART link before physical work.
; Final pin selection requires the exact board/module markings and exposed-pin check.

[COMPONENTS]
MCU_MAIN = ESP32_WROOM_32U_EXTERNAL_ANTENNA_DEV_BOARD_USER_REFERENCE
MCU_C3   = ESP32_C3_SUPERMINI_USB_C_USER_REFERENCE
R_C3_TX  = SERIES_RESISTOR_2K2
R_MAIN_TX = SERIES_RESISTOR_2K2

[LOGIC_LEVEL]
UART = 3V3_ONLY

; ESP32-C3 native UART0 pins. Official SoC mapping:
; GPIO20 = U0RXD, GPIO21 = U0TXD.
; The supplied SuperMini images confirm both labels and physical access.
[NET_C3_TX_SOURCE]
MCU_C3.GPIO21_U0TXD
R_C3_TX.1

[NET_C3_TX_TO_MAIN_RX]
R_C3_TX.2
MCU_MAIN.GPIO16_U2RXD

[NET_MAIN_TX_SOURCE]
MCU_MAIN.GPIO17_U2TXD
R_MAIN_TX.1

[NET_MAIN_TX_TO_C3_RX]
R_MAIN_TX.2
MCU_C3.GPIO20_U0RXD

[NET_COMMON_GND]
MCU_MAIN.GND
MCU_C3.GND

[EXPLICITLY_NOT_CONNECTED]
MCU_MAIN.3V3 --X-- MCU_C3.3V3
MCU_MAIN.5V  --X-- MCU_C3.5V
MCU_MAIN.EN  --X-- MCU_C3.EN
MCU_MAIN.ANY --X-- MCU_C3.GPIO9_BOOT

[PATH_SUMMARY]
C3_TO_MAIN = MCU_C3.GPIO21_U0TXD -> R_C3_TX.1 -> R_C3_TX.2 -> MCU_MAIN.GPIO16_U2RXD
MAIN_TO_C3 = MCU_MAIN.GPIO17_U2TXD -> R_MAIN_TX.1 -> R_MAIN_TX.2 -> MCU_C3.GPIO20_U0RXD
GROUND = MCU_C3.GND -> MCU_MAIN.GND

[EXISTING_MAIN_PIN_CONTRACT]
GPIO21 = I2C_SDA
GPIO22 = I2C_SCL
GPIO25 = INMP441_WS
GPIO26 = INMP441_BCLK
GPIO27 = USER_BUTTON
GPIO32 = INMP441_DATA

[EXISTING_C3_PIN_CONTRACT]
GPIO0 = INA3221_SDA
GPIO1 = INA3221_SCL
GPIO3 = CHARGE_CONTROL_ACTIVE_HIGH
GPIO4 = GPS_UART_RX_FROM_GPS_TX
GPIO5 = GPS_UART_TX_RESERVED_PHYSICALLY_DISCONNECTED
GPIO6 = GPS_POWER_CONTROL_ACTIVE_HIGH
GPIO8 = ONBOARD_LED
GPIO9 = BOOT_STRAPPING_DO_NOT_USE
GPIO18 = USB_D_MINUS_DO_NOT_USE
GPIO19 = USB_D_PLUS_DO_NOT_USE

[MAIN_GPIO16_GPIO17_ACCEPTANCE_GATE]
1 = PASS: user reference identifies an ESP32-WROOM-32U external-antenna board.
2 = PASS: the supplied 32U reference is not a QSPI-PSRAM WROOM-32E/32UE variant.
3 = PASS: carrier pins GPIO16 and GPIO17 are visibly exposed and labelled.
4 = PASS_SOURCE_AUDIT: current BSPRJ firmware and documented wiring use neither pin.
5 = PHYSICAL_RECHECK_REQUIRED: read GPIO labels once more on the actual board before soldering.

[C3_GPIO20_GPIO21_ACCEPTANCE_GATE]
1 = PASS: supplied SuperMini images visibly expose GPIO20 and GPIO21.
2 = PASS_DESIGN: USB-C uses the ESP32-C3 native USB GPIO18/GPIO19 path.
3 = PHYSICAL_TEST_PENDING: confirm USB upload/recovery again before UART firmware is added.
4 = WROOM must transmit nothing while C3 resets until the application UART handshake.
5 = WROOM must discard C3 ROM boot text until a valid framed protocol message arrives.

[FALLBACK_MAIN_PAIR_NOT_SELECTED]
RX_CANDIDATE = GPIO18
TX_CANDIDATE = GPIO19
RULE = Use only after physical-board and future-SIM800 pin audit.

[PHYSICAL_RULES_FOR_NEXT_STAGE]
1 = Disconnect Battery, Solar, both USB cables, and every bench supply first.
2 = Never move or connect UART wiring while either controller is powered.
3 = Keep both UART wires at the user-confirmed planned maximum of 7-8 cm.
4 = Route UART away from I2S, GPS, DC-DC switching nodes, and future SIM800 wiring.
5 = Use one 2.2 kOhm series resistor in each transmitter line.
6 = Series resistors reduce contention/back-power current but are not galvanic isolation.
7 = Do not connect controller power rails; only signal lines and common GND are shared.

[CONFIRMATION_REQUIRED_FROM_USER]
MAIN_MODULE_FULL_MARKING = ESP32-WROOM-32U_IN_USER_REFERENCE_IMAGE
MAIN_CARRIER_BOARD_MARKING = EXTERNAL_ANTENNA_DEV_BOARD_IN_USER_REFERENCE_IMAGE
MAIN_GPIO16_LABEL_VISIBLE = YES
MAIN_GPIO17_LABEL_VISIBLE = YES
C3_BOARD_MARKING = ESP32-C3_SUPERMINI_IN_USER_REFERENCE_IMAGES
C3_GPIO20_LABEL_VISIBLE = YES
C3_GPIO21_LABEL_VISIBLE = YES
PLANNED_UART_WIRE_LENGTH_CM = MAX_7_TO_8
AVAILABLE_SERIES_RESISTOR_VALUE = ANY_REQUIRED_VALUE_AVAILABLE
SELECTED_SERIES_RESISTOR_VALUE = 2K2_EACH_DIRECTION

[CURRENT_VERDICT]
C3_GPIO20_GPIO21_SOC_MAPPING = CONFIRMED
C3_PHYSICAL_BOARD_ACCESS = CONFIRMED_BY_USER_IMAGES
MAIN_GPIO16_GPIO17_SOC_MAPPING = CONFIRMED
MAIN_GPIO16_GPIO17_32U_CARRIER_ACCESS = CONFIRMED_BY_USER_IMAGE
UART_WIRE_LENGTH = ACCEPTED_MAX_8_CM
SERIES_RESISTORS = SELECTED_2K2
PHYSICAL_PIN_PLAN = APPROVED
PHYSICAL_WIRING = USER_REPORTED_COMPLETE_2026_08_15
POWERLESS_CONTINUITY_TEST = USER_REPORTED_PASS_2026_08_15
CONTINUITY_EVIDENCE = GND_OK_BOTH_UART_PATHS_APPROX_2K2_NO_SHORTS
EXACT_METER_VALUES = NOT_RECORDED
DUAL_CONTROLLER_POWER_ON = USER_REPORTED_NORMAL_2026_08_15
HARD_SHORT_OR_STARTUP_FAILURE = NOT_OBSERVED
ONE_BOARD_AT_A_TIME_BACKFEED_TEST = NOT_PERFORMED
BACKFEED_TEST_DISPOSITION = DEFERRED_UNTIL_CONVENIENT_SEPARATE_POWER_EVENT
BSPRJ_UART_FIRMWARE = BUILD_117_USER_CONFIRMED_UPLOADED_AND_ONLINE_2026_08_15
C3_UART_FIRMWARE = BUILD_183_USER_CONFIRMED_UPLOADED_AND_ONLINE_2026_08_15
UART_DATA_TRANSFER = USER_CONFIRMED_PASS_2026_08_15
FIRST_VALID_PONG = C3_BUILD_183_RTT_13104_MS_DURING_STARTUP
TRANSIENT_LINK_STATE = FALSE_OFFLINE_AFTER_10S_TIMEOUT
RECOVERY = AUTOMATIC_PONG_RTT_870_MS
WROOM_STAT_EVIDENCE = UART_OK_BUILD_183_RTT_870_MS
PHYSICAL_UART_VERDICT = PASS
OPEN_DIAGNOSTIC_RISK = SINGLE_10S_TIMEOUT_TOO_SHORT_DURING_C3_NETWORK_BLOCKING
BUILD_117_OFFLINE_POLICY = THREE_CONSECUTIVE_10S_TIMEOUTS
BUILD_117_VALIDATION = PASS_PLANNED_DEEP_SLEEP_OK_TO_OFF_TO_OK_RTT_7002_MS
PLANNED_SLEEP_TEST = C3_SLEEP_10_MINUTES_NEXT_WAKE_01_47_USER_CONFIRMED
PLANNED_SLEEP_RESULT = EXPECTED_OFF_DURING_SLEEP_AUTOMATIC_ONLINE_AFTER_WAKE
BSPRJ_STAGED_FIRMWARE = BUILD_118_SLEEP_STATE
C3_STAGED_FIRMWARE = BUILD_184_SLEEP_ANNOUNCEMENT
SLEEP_FRAME = SLEEP_SECONDS_C3_BUILD
SLEEP_STATE = WROOM_SLP_WITH_REMAINING_SECONDS
SLEEP_PING_POLICY = PAUSE_UNTIL_EXPECTED_WAKE_THEN_RESUME
LOCAL_BUILD_VALIDATION = PASS_BOTH_CONTROLLERS_2026_08_15
SLEEP_PROTOCOL_DEVICE_VALIDATION = PASS_OK_TO_SLP_TO_WAIT_TO_OK
SLEEP_FRAME_EVIDENCE = C3_BUILD_184_FOR_600_SECONDS
SLEEP_COUNTDOWN_EVIDENCE = 580_TO_9_SECONDS_WITHOUT_OFFLINE
EXPECTED_WAKE_EVIDENCE = WAKE_WAIT_THEN_ONLINE_C3_BUILD_184_RTT_48_MS
CURRENT_BSPRJ_DEVICE_FIRMWARE = BUILD_118_USER_CONFIRMED
CURRENT_C3_DEVICE_FIRMWARE = BUILD_184_USER_CONFIRMED

[APPLICATION_PROTOCOL]
CANONICAL_SPEC = CONTROLLER_UART_PROTOCOL.md
HEARTBEAT = PING_SEQUENCE_TO_PONG_SEQUENCE_C3_BUILD
EXPECTED_SLEEP = SLEEP_SECONDS_C3_BUILD
POWER_TELEMETRY_V1 = TEL_SESSION_SEQUENCE_VALID_SOLAR_MV_MA_BATTERY_MV_MA_LOAD_MV_MA_SOC_CHARGE_MODE
TELEMETRY_ACK = ACK_SESSION_SEQUENCE
TELEMETRY_INTERVAL = APPROX_30_SECONDS_WHILE_C3_AWAKE
ACK_TIMEOUT = 2_SECONDS
MAX_RETRIES_AFTER_FIRST_SEND = 3
DEDUPLICATION_KEY = SESSION_PLUS_SEQUENCE
WROOM_STAGED_FIRMWARE = BUILD_119_TEL_ACK
C3_STAGED_FIRMWARE = BUILD_185_TEL_RETRY
TELEMETRY_LOCAL_BUILD_VALIDATION = PASS_BOTH_CONTROLLERS_2026_08_15
TELEMETRY_DEVICE_VALIDATION = PENDING_MANUAL_UPLOAD_AND_REAL_TEL_ACK
